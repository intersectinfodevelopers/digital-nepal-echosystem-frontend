{
  "name": "digital-nepal-echosystem-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:geojson": "node scripts/setup-geojson.js",
    "postinstall": "npm run setup:geojson",
    "predev": "npm run setup:geojson",
    "prebuild": "npm run setup:geojson",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "analyze": "ANALYZE=true next build",
    "build:tiles": "docker run --rm -v \"${PWD}:/data\" mapbox/tippecanoe tippecanoe -o /data/public/tiles/nepal.mbtiles -Z6 -z14 --drop-smallest-as-needed /data/public/geojson/local-bodies/*.json",
    "serve-tiles": "npx tileserver-gl-light public/tiles/nepal.mbtiles"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "nanoid": "^3.3.12",
    "nepal-geojson": "^5.0.0-alpha",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
